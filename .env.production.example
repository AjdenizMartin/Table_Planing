APP_DOMAIN=reservas.example.com
PILOT_RELEASE_TAG=v0.1.0-rc.2
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DB=restaurant_planner
POSTGRES_USER=restaurant_planner
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
JWT_SECRET_FILE=./secrets/jwt_secret.txt
LETSENCRYPT_DIR=./deploy/letsencrypt
ACME_WEBROOT_DIR=./deploy/certbot-www
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
TLS_EMAIL=operations@example.com
RESTIC_REPOSITORY=s3:https://s3.example.com/table-planning-backups
RESTIC_PASSWORD_FILE=./secrets/restic_password.txt
AWS_ACCESS_KEY_ID_FILE=./secrets/s3_access_key.txt
AWS_SECRET_ACCESS_KEY_FILE=./secrets/s3_secret_key.txt
RESTIC_KEEP_DAILY=14
RESTIC_KEEP_WEEKLY=8
RESTIC_KEEP_MONTHLY=12
OPS_BACKUP_MAX_AGE_MINUTES=1560
OPS_DISK_USAGE_LIMIT_PERCENT=85
OPS_TLS_WARNING_SECONDS=1209600
OPS_CHECK_RESTIC=true
OPS_ALERT_WEBHOOK_URL_FILE=
